#version 450

#include "utils.glsl"

#extension GL_EXT_control_flow_attributes : enable
#define BLOCK_SIZE 128

// S2-⑦: fused RoPE chain {GET_ROWS, MUL, MUL, ADD} in one dispatch.
// Reads q2 [M, D] (M = H*S*N rows, D = head dim), ids [D] (sigma=d^1 swap
// table: partner(d) = d^1, adjacent-pair exchange), cos2/sin2 [M, D] (sign
// already baked into the sin table -- the chain has no subtraction), and
// writes dst [M, D]:
//   dst[row*D + col] = q2[row*D + col] * cos2[row*D + col]
//                    + q2[row*D + ids[col]] * sin2[row*D + col]
// Binding: 0=A(q2), 1=B(ids), 2=C(cos2), 3=D(sin2), 4=E(dst).
layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

layout (push_constant) uniform parameter {
    uint M; uint D;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
    uint ne30; uint ne31; uint ne32; uint ne33; uint nb30; uint nb31; uint nb32; uint nb33;
    uint ne40; uint ne41; uint ne42; uint ne43; uint nb40; uint nb41; uint nb42; uint nb43;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {int   data_b[];};
layout (binding = 2) readonly buffer C {float data_c[];};
layout (binding = 3) readonly buffer D {float data_d[];};
layout (binding = 4) writeonly buffer E {float data_e[];};

void main() {
    const uint M = p.M;
    const uint D = p.D;
    const uint tid = gl_GlobalInvocationID.x;
    const uint total = M * D;
    const uint stride = BLOCK_SIZE * gl_NumWorkGroups.x;
    // q2/cos2/sin2/dst all claim ne = {M, D} but with DIFFERENT strides:
    // q2 is row-major (ne0=M fastest, d stride nb10 = D), while cos2/sin2 are
    // column-major (d stride nb30/nb40 = M, from ropeCosTable2D's i0 + M*d).
    // Every access therefore goes through the tensor's own nb (element units).
    for (uint i = tid; i < total; i += stride) {
        const uint d  = i / D;        // ne1 index (head dim)
        const uint i0 = i - d * D;    // ne0 index (position)
        const uint id = uint(data_b[d]);
        // S2-⑦: precise pins the IEEE double-rounding semantics (two FMuls and
        // one FAdd, each rounding once) so the fused pass is bit-exact with the
        // plain chain (mul -> SSBO -> mul -> SSBO -> add). Without it the driver
        // is allowed to contract mul+add into FMA (single rounding); the 1-ULP
        // difference on ~22% of elements gets amplified through the F16
        // downstream ops and breaks b11's margin. glslang emits OpDecorate
        // NoContraction for variables declared precise.
        precise float t1 = data_a[i0 + d * p.nb01] * data_c[i0 + d * p.nb21];
        precise float t2 = data_a[i0 + id * p.nb01] * data_d[i0 + d * p.nb31];
        data_e[i0 + d * p.nb41] = t1 + t2;
    }
}
