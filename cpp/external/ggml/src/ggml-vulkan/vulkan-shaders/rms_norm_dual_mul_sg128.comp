#version 450

#include "utils.glsl"

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_basic : enable
// N51 (rms-bw-prior.md, 2026-09-10): 512 -> 128 threads.
// KataGo's rows are 192/256/384 wide, so with 512 threads 25-62.5% of the
// workgroup was idle (col < ncols) and only 2 workgroups fit per SM (thread
// limit). 128 threads keep every lane busy (num_iters = 2/2/3) and allow up to 8
// workgroups per SM. The reduction below is the matching change: a subgroup
// reduce plus one cross-subgroup step costs 3 barriers instead of the
// BLOCK_SIZE-wide tree's 11 (label: "N51" in next-temp.md / rms-bw-prior.md).
#define BLOCK_SIZE 128

layout(local_size_x = BLOCK_SIZE, local_size_y = 1, local_size_z = 1) in;

// C-N25: fused rms_norm + mul(gamma) + mul(mask) in one dispatch.
// Push constants: standard binary layout (src0=x, src1=gamma, dst) plus the
// mask (second mul src) ne/nb block. Binding: 0=A(x), 1=B(gamma), 2=C(mask),
// 3=D(dst). gamma is a per-channel [C] row-broadcast operand; mask is a
// per-position [1,S,N] column-broadcast operand -- both addressed via
// fastmod(col, ne0) with their own nb, so arbitrary broadcast shapes work.
layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03; uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13; uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23; uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
    uint mne00; uint mne01; uint mne02; uint mne03; uint mnb00; uint mnb01; uint mnb02; uint mnb03;
} p;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) readonly buffer B {float data_b[];};
layout (binding = 2) readonly buffer C {float data_c[];};
layout (binding = 3) writeonly buffer D {float data_d[];};

shared float sumsh[BLOCK_SIZE];

void rms_norm_mul_mul(uint num_iters) {
    const uint ncols     = p.ne00;
    const uint nrows     = gl_NumWorkGroups.x;
    const uint nchannels = gl_NumWorkGroups.y;
    const uint row       = gl_WorkGroupID.x;
    const uint channel   = gl_WorkGroupID.y;
    const uint samp      = gl_WorkGroupID.z;
    const uint tid       = gl_LocalInvocationID.x;

    const uint stride_row     = p.nb01;
    const uint stride_channel = p.nb02;
    const uint stride_sample  = p.nb03;

    uint a_offset = samp*stride_sample + channel*stride_channel + row*stride_row + (p.misalign_offsets >> 16);
    // gamma [C,1,1,1]: row/channel/samp broadcast to 0 via fastmod(x, ne1x==1)
    uint b_offset = fastmod(row, p.ne11)*p.nb11 + fastmod(channel, p.ne12)*p.nb12 + fastmod(samp, p.ne13)*p.nb13 + ((p.misalign_offsets >> 8) & 0xFF);
    // mask [1,S,N]: col broadcasts via fastmod(col, mne00); row/channel direct
    uint c_offset = fastmod(row, p.mne01)*p.mnb01 + fastmod(channel, p.mne02)*p.mnb02 + fastmod(samp, p.mne03)*p.mnb03;
    uint d_offset = ((samp*p.ne22 + channel)*p.ne21 + row)*p.ne20 + (p.misalign_offsets & 0xFF);

    float sum = 0.0f;
    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
        if (col < ncols) {
            float xi = data_a[a_offset + col];
            sum += xi * xi;
        }
    }

    // N51: reduce inside each subgroup first, then across the few subgroups
    // through shared memory (the same shape as add.comp's ADD_RMS path).
    // The arithmetic order changes vs the old full-width tree, so this is NOT
    // bit-equal to the previous build -- the margin gate covers it.
    const uint num_subgroups = BLOCK_SIZE / gl_SubgroupSize;
    sum = subgroupAdd(sum);
    if (gl_SubgroupInvocationID == 0) {
        sumsh[gl_SubgroupID] = sum;
    }
    barrier();
    [[unroll]] for (uint s = num_subgroups / 2; s > 0; s >>= 1) {
        if (gl_SubgroupID < s && gl_SubgroupInvocationID == 0) {
            sum += sumsh[gl_SubgroupID + s];
            sumsh[gl_SubgroupID] = sum;
        }
        barrier();
    }
    sum = sumsh[0];

    const float mean = sum / float(ncols);
    const float scale = inversesqrt(mean + p.param1);

    [[unroll]] for (uint col = tid, idx = 0; idx < num_iters; col += BLOCK_SIZE, ++idx) {
        if (col >= ncols) {
            continue;
        }
        float gamma = data_b[b_offset + fastmod(col, p.ne10)];
        float mask  = data_c[c_offset + fastmod(col, p.mne00)];
        data_d[d_offset + col] = scale * data_a[a_offset + col] * gamma * mask;
    }
}

void main() {
    uint num_blocks = (p.ne00 + BLOCK_SIZE - 1) / BLOCK_SIZE;
    if (num_blocks > 32) {
        rms_norm_mul_mul(num_blocks);
    } else if (num_blocks > 16) {
        rms_norm_mul_mul(32);
    } else if (num_blocks > 12) {
        rms_norm_mul_mul(16);
    } else if (num_blocks > 10) {
        rms_norm_mul_mul(12);
    } else if (num_blocks > 8) {
        rms_norm_mul_mul(10);
    } else if (num_blocks > 4) {
        rms_norm_mul_mul(8);
    } else if (num_blocks == 4) {
        rms_norm_mul_mul(4);
    } else if (num_blocks == 3) {
        rms_norm_mul_mul(3);
    } else if (num_blocks == 2) {
        rms_norm_mul_mul(2);
    } else if (num_blocks == 1) {
        rms_norm_mul_mul(1);
    }
}
