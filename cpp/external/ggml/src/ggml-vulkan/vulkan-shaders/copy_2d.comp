#version 450

#include "types.glsl"
#include "generic_unary_head.glsl"

// KataGo vendored shader (N52, 2026-09-11): 2D strided copy into a CONTIGUOUS
// destination. This is the dominant CONT family for KataGo (census13: 42.4% of all
// CONT bytes, one uniform shape `ne=[256,2888,1,1]`, src nb=[4,B,..] elements, i.e.
// every 256th.. block of a 768-wide row) which until now fell through to the generic
// `copy.comp`: that one is fully general and pays 4 fastdiv-based index computations
// per element for BOTH sides. Here the destination is contiguous by contract (the
// caller is ggml_vk_cpy_to_contiguous, which sets nb10=1,nb11=ne0,...) so the store
// index is simply the linear element index, and the load index needs a single
// divide (dims 2/3 are 1, so the outer steps of src0_idx collapse).
//
// The host only selects this shader when: src/dst are f32, the destination is
// contiguous and of the same shape, src dim0 is contiguous (nb00 == sizeof(float)),
// and dims 2/3 are 1. Anything else keeps the generic path (see
// ggml_vk_get_cpy_pipeline). KATAGO_VK_CPY_2D=0 disables it (rollback).
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;

void main() {
    const uint idx = get_idx();

    if (idx >= p.ne) {
        return;
    }

    // i01 = idx / ne00, i00 = idx % ne00 (ne02 == ne03 == 1)
    const uint i01 = fastdiv(idx, p.ne0_0mp, fastdiv_L(p.ne0_Ls, 2));
    const uint i00 = idx - i01 * p.ne00;

    data_d[get_doffset() + idx] = D_TYPE(data_a[get_aoffset() + i01 * p.nb01 + i00 * p.nb00]);
}
